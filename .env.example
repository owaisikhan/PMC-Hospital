# Supabase — from Project Settings -> API in the Supabase dashboard.
# Copy this file to .env.local and fill in the real values.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Project Settings -> API Keys -> service_role secret. NEVER prefix this with
# NEXT_PUBLIC_ or commit the real value — it bypasses row level security
# entirely. Used only by "use server" actions to create a login or reset a
# password on an admin's behalf. Set the same value on Vercel too.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
